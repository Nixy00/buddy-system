{% extends 'base.html.twig' %}

{% block title %}Créer un événement - Buddy System{% endblock %}

{% block main %}
<div class="container" style="padding-top: 3rem;">
    <a href="{{ path('app_events') }}" class="btn btn--ghost" style="margin-bottom: 2rem;">&larr; Retour à la liste</a>
    
    <div class="page-header">
        <h1>Créer un nouvel événement</h1>
        <p class="muted">Proposez une activité à la communauté !</p>
    </div>

    <div style="background: white; padding: 3rem; border-radius: var(--radius-lg); border: 1px solid #E5E7EB; text-align: center;">
        <p>Le formulaire de création sera disponible prochainement.</p>
        <p class="muted">Fonctionnalité en cours de développement.</p>
    </div>
</div>
{% endblock %}
