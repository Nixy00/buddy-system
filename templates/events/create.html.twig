{% extends 'base.html.twig' %}

{% block title %}

    <h1 class="h1">
    {% if is_granted('ROLE_ADMIN') %}
        Créer un nouvel événement
    {% else %}
        Proposer un nouvel événement
    {% endif %}
    </h1>

{% endblock %}

{% block main %}
    <style>
        .form-control:focus {
            border-color: var(--color-primary) !important;
            box-shadow: 0 0 0 3px rgba(230, 57, 70, 0.1) !important;
            outline: none;
        }
        .btn--primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(230, 57, 70, 0.3) !important;
        }
        .btn--secondary:hover {
            background-color: var(--gray-50) !important;
            border-color: var(--gray-400) !important;
        }
        .profile-section {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .profile-section:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.08) !important;
        }
    </style>
    <div class="breadcrumb" style="background: white; padding: 12px 0; border-bottom: 1px solid var(--gray-200); font-size: 0.9rem;">
        <div class="container">
            <a href="{{ path('app_home') }}" style="color: var(--gray-500); text-decoration: none;">Accueil</a>
            <span style="color: var(--gray-400); margin: 0 8px;">/</span>
            <a href="{{ path('app_events') }}" style="color: var(--gray-500); text-decoration: none;">Événements</a>
            <span style="color: var(--gray-400); margin: 0 8px;">/</span>
            <span style="color: var(--gray-900);">
                {% if is_granted('ROLE_ADMIN') %}
                    Créer un nouvel événement
                {% else %}
                    Proposer un nouvel événement
                {% endif %}
            </span>

        </div>
    </div>

    <div class="container" style="padding-top: 3rem; padding-bottom: 4rem;">
        <div class="page-header" style="margin-bottom: 2rem;">
            {% if is_granted('ROLE_ADMIN') %}
                <h1 style="font-size: 2rem; color: var(--gray-900); margin-bottom: 0.5rem;">Créer un nouvel événement</h1>
                <p class="lead">Remplissez ce formulaire afin de créer votre évenement.</p>
            {% else %}
                <h1 style="font-size: 2rem; color: var(--gray-900); margin-bottom: 0.5rem;">Proposer un nouvel événement</h1>
                <p class="lead">Remplissez ce formulaire. Votre événement sera soumis à validation avant d'être publié.</p>
            {% endif %}
        </div>

        {{ form_start(form) }}
            <div style="display: grid; gap: 2rem; max-width: 800px; margin: 0 auto;">

                {# Section 1: Informations Principales #}
                <div class="profile-section" style="background: white; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid var(--gray-100);">
                    <h2 class="section-title" style="font-size: 1.25rem; font-weight: 600; color: var(--gray-900); margin: 0 0 24px; display: flex; align-items: center; gap: 10px;">
                        <i class="fas fa-info-circle" style="color: var(--color-primary);"></i>
                        Informations Principales
                    </h2>

                    <div style="display: grid; gap: 20px;">
                        <div class="form-group">
                            {{ form_label(form.titre, null, {label_attr: {style: 'display: block; margin-bottom: 8px; font-weight: 500; color: var(--gray-700);'}}) }}
                            {{ form_widget(form.titre, {attr: {style: 'width: 100%; padding: 10px 14px; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 1rem;'}}) }}
                            {{ form_errors(form.titre) }}
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <div class="form-group">
                                {{ form_label(form.categorie, null, {label_attr: {style: 'display: block; margin-bottom: 8px; font-weight: 500; color: var(--gray-700);'}}) }}
                                {{ form_widget(form.categorie, {attr: {style: 'width: 100%; padding: 10px 14px; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 1rem; background-color: white;'}}) }}
                                {{ form_errors(form.categorie) }}
                            </div>

                            <div class="form-group">
                                {{ form_label(form.image, null, {label_attr: {style: 'display: block; margin-bottom: 8px; font-weight: 500; color: var(--gray-700);'}}) }}
                                {{ form_widget(form.image, {attr: {style: 'width: 100%; padding: 7px; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 1rem; background: white;'}}) }}
                                {{ form_errors(form.image) }}
                            </div>
                        </div>
                    </div>
                </div>

                {# Section 2: Détails #}
                <div class="profile-section" style="background: white; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid var(--gray-100);">
                    <h2 class="section-title" style="font-size: 1.25rem; font-weight: 600; color: var(--gray-900); margin: 0 0 24px; display: flex; align-items: center; gap: 10px;">
                        <i class="fas fa-align-left" style="color: var(--color-primary);"></i>
                        Détails
                    </h2>

                    <div style="display: grid; gap: 20px;">
                        <div class="form-group">
                            {{ form_label(form.description, null, {label_attr: {style: 'display: block; margin-bottom: 8px; font-weight: 500; color: var(--gray-700);'}}) }}
                            {{ form_widget(form.description, {attr: {style: 'width: 100%; padding: 10px 14px; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 1rem; resize: vertical; min-height: 120px; font-family: inherit;'}}) }}
                            {{ form_errors(form.description) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.lieu, null, {label_attr: {style: 'display: block; margin-bottom: 8px; font-weight: 500; color: var(--gray-700);'}}) }}
                            <div style="position: relative;">
                                <i class="fas fa-map-marker-alt" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--gray-400);"></i>
                                {{ form_widget(form.lieu, {attr: {style: 'width: 100%; padding: 10px 14px 10px 40px; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 1rem;'}}) }}
                            </div>
                            {{ form_errors(form.lieu) }}
                        </div>
                    </div>
                </div>

                {# Section 3: Dates & Capacité #}
                <div class="profile-section" style="background: white; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid var(--gray-100);">
                    <h2 class="section-title" style="font-size: 1.25rem; font-weight: 600; color: var(--gray-900); margin: 0 0 24px; display: flex; align-items: center; gap: 10px;">
                        <i class="fas fa-calendar-alt" style="color: var(--color-primary);"></i>
                        Dates & Capacité
                    </h2>

                    <div style="display: grid; gap: 20px;">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <div class="form-group">
                                {{ form_label(form.dateDebut, null, {label_attr: {style: 'display: block; margin-bottom: 8px; font-weight: 500; color: var(--gray-700);'}}) }}
                                {{ form_widget(form.dateDebut, {attr: {style: 'width: 100%; padding: 10px 14px; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 1rem; font-family: inherit;'}}) }}
                                {{ form_errors(form.dateDebut) }}
                            </div>

                            <div class="form-group">
                                {{ form_label(form.dateFin, null, {label_attr: {style: 'display: block; margin-bottom: 8px; font-weight: 500; color: var(--gray-700);'}}) }}
                                {{ form_widget(form.dateFin, {attr: {style: 'width: 100%; padding: 10px 14px; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 1rem; font-family: inherit;'}}) }}
                                {{ form_errors(form.dateFin) }}
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <div class="form-group">
                                {{ form_label(form.dateLimiteInscr, null, {label_attr: {style: 'display: block; margin-bottom: 8px; font-weight: 500; color: var(--gray-700);'}}) }}
                                {{ form_widget(form.dateLimiteInscr, {attr: {style: 'width: 100%; padding: 10px 14px; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 1rem; font-family: inherit;'}}) }}
                                {{ form_errors(form.dateLimiteInscr) }}
                            </div>

                            <div class="form-group">
                                {{ form_label(form.capacite, null, {label_attr: {style: 'display: block; margin-bottom: 8px; font-weight: 500; color: var(--gray-700);'}}) }}
                                {{ form_widget(form.capacite, {attr: {style: 'width: 100%; padding: 10px 14px; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 1rem;'}}) }}
                                {{ form_errors(form.capacite) }}
                            </div>
                        </div>
                    </div>
                </div>

                {# Actions #}
                <div class="form-actions" style="display: flex; justify-content: flex-end; gap: 16px; padding-top: 10px;">
                    <a href="{{ path('app_events') }}" class="btn btn--secondary" style="padding: 12px 24px; border-radius: 30px; border: 1px solid var(--gray-300); color: var(--gray-700); background: white; text-decoration: none; font-weight: 500;">
                        Annuler
                    </a>
                    <button type="submit" class="btn btn-primary">
                        {% if is_granted('ROLE_ADMIN') %}
                            <i class="fas fa-check"></i> Créer l'événement
                        {% else %}
                            <i class="fas fa-paper-plane"></i> Envoyer la demande
                        {% endif %}
                    </button>
                </div>

            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
