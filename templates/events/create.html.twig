{% extends 'base.html.twig' %}

{% block title %}Créer un événement - Buddy System{% endblock %}

{% block main %}
    <div class="breadcrumb" style="background: white; padding: 12px 0; border-bottom: 1px solid var(--gray-200); font-size: 0.9rem;">
        <div class="container">
            <a href="{{ path('app_home') }}" style="color: var(--gray-500); text-decoration: none;">Accueil</a>
            <span style="color: var(--gray-400); margin: 0 8px;">/</span>
            <a href="{{ path('app_events') }}" style="color: var(--gray-500); text-decoration: none;">Événements</a>
            <span style="color: var(--gray-400); margin: 0 8px;">/</span>
            <span style="color: var(--gray-900);">Créer un événement</span>
        </div>
    </div>

    <div class="container" style="padding-top: 3rem; padding-bottom: 4rem;">
        <div class="page-header" style="margin-bottom: 2rem;">
            <h1 style="font-size: 2rem; color: var(--gray-900); margin-bottom: 0.5rem;">Créer un nouvel événement</h1>
            <p style="color: var(--gray-600);">Proposez une activité à la communauté !</p>
        </div>
        
        <form action="#" method="post">
            <div style="display: grid; gap: 2rem; max-width: 800px; margin: 0 auto;">
                
                {# Section 1: Informations Principales #}
                <div class="profile-section" style="background: white; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid var(--gray-100);">
                    <h2 class="section-title" style="font-size: 1.25rem; font-weight: 600; color: var(--gray-900); margin: 0 0 24px; display: flex; align-items: center; gap: 10px;">
                        <i class="fas fa-info-circle" style="color: var(--color-primary);"></i>
                        Informations Principales
                    </h2>

                    <div style="display: grid; gap: 20px;">
                        <div class="form-group">
                            <label for="event_titre" style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--gray-700);">Titre de l'événement</label>
                            <input type="text" id="event_titre" name="titre" class="form-control" placeholder="Ex: Soirée Jeux de Société" style="width: 100%; padding: 10px 14px; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 1rem;">
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <div class="form-group">
                                <label for="event_categorie" style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--gray-700);">Catégorie</label>
                                <select id="event_categorie" name="categorie" class="form-control" style="width: 100%; padding: 10px 14px; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 1rem; background-color: white;">
                                    <option value="" disabled selected>Choisir une catégorie</option>
                                    <option value="Sport">Sport</option>
                                    <option value="Culture">Culture</option>
                                    <option value="Loisirs">Loisirs</option>
                                    <option value="Intégration">Intégration</option>
                                    <option value="Autre">Autre</option>
                                </select>
                            </div>
                            
                            <div class="form-group">
                                <label for="event_image" style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--gray-700);">Image de couverture</label>
                                <input type="file" id="event_image" name="image" class="form-control" accept="image/*" style="width: 100%; padding: 7px; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 1rem; background: white;">
                            </div>
                        </div>
                    </div>
                </div>

                {# Section 2: Détails #}
                <div class="profile-section" style="background: white; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid var(--gray-100);">
                    <h2 class="section-title" style="font-size: 1.25rem; font-weight: 600; color: var(--gray-900); margin: 0 0 24px; display: flex; align-items: center; gap: 10px;">
                        <i class="fas fa-align-left" style="color: var(--color-primary);"></i>
                        Détails
                    </h2>

                    <div style="display: grid; gap: 20px;">
                        <div class="form-group">
                            <label for="event_description" style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--gray-700);">Description complète</label>
                            <textarea id="event_description" name="description" class="form-control" rows="5" placeholder="Décrivez le programme, l'ambiance, ce qu'il faut apporter..." style="width: 100%; padding: 10px 14px; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 1rem; resize: vertical; min-height: 120px; font-family: inherit;"></textarea>
                        </div>

                        <div class="form-group">
                            <label for="event_lieu" style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--gray-700);">Lieu</label>
                            <div style="position: relative;">
                                <i class="fas fa-map-marker-alt" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--gray-400);"></i>
                                <input type="text" id="event_lieu" name="lieu" class="form-control" placeholder="Adresse ou nom du lieu" style="width: 100%; padding: 10px 14px 10px 40px; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 1rem;">
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </form>
    </div>
{% endblock %}
