{% extends 'base.html.twig' %}

{% block title %}Événements - Buddy System{% endblock %}

{% block main %}
<div class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
    <div class="page-header" style="margin-bottom: 2rem; text-align: center;">
        <h1 style="font-size: 2.5rem; font-weight: 700; color: var(--color-text);">Découvrez nos Événements</h1>
        <p class="muted" style="font-size: 1.125rem;">Participez à la vie étudiante et rencontrez vos futurs parrains/filleuls !</p>
    </div>

    <!-- Filtres -->
    <div class="filters-bar" style="background: #F3F4F6; padding: 1.5rem; border-radius: var(--radius-lg); margin-bottom: 3rem;">
        <form class="filters-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
            <div class="form-group">
                <input type="text" placeholder="Rechercher un événement..." class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid #D1D5DB; border-radius: var(--radius);">
            </div>
            <div class="form-group">
                <select class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid #D1D5DB; border-radius: var(--radius);">
                    <option value="">Toutes les catégories</option>
                    <option value="integration">Intégration</option>
                    <option value="culture">Culture</option>
                    <option value="sport">Sport</option>
                    <option value="loisirs">Loisirs</option>
                </select>
            </div>
            <div class="form-group">
                <input type="date" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid #D1D5DB; border-radius: var(--radius);">
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn--primary" style="width: 100%;">Filtrer</button>
            </div>
        </form>
    </div>

    <!-- Grille des événements -->
    <div class="events-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem;">
        {% for event in events %}
            {% include 'events/_event_card.html.twig' %}
        {% else %}
            <div class="no-events" style="grid-column: 1 / -1; text-align: center; padding: 3rem; background: #F9FAFB; border-radius: var(--radius-lg);">
                <p class="muted">Aucun événement ne correspond à vos critères.</p>
            </div>
        {% endfor %}
    </div>

</div>
{% endblock %}
