{% extends 'base.html.twig' %}

{% block title %}Événements - Buddy System{% endblock %}

{% block main %}
<div class="container" style="padding: 2rem 0 4rem 0;">
    <div class="page-header">
        <h1>Découvrez nos Événements</h1>
        <p class="muted">Participez à la vie étudiante et rencontrez vos futurs parrains/filleuls !</p>
        <div style="margin-top: 1.5rem;">
            <a href="{{ path('app_event_create') }}" class="btn btn--primary">Créer un événement</a>
        </div>
    </div>

    <!-- Filtres -->
    <div class="filters-bar">
        <form action="{{ path('app_events') }}" method="get" class="filters-grid">
            <div class="form-group">
                <input type="text" name="search" placeholder="Rechercher un événement..." class="form-control" value="{{ search_filtre|default('') }}">
            </div>
            <div class="form-group">
                <select name="category" class="form-control">
                    <option value="">Toutes les catégories</option>
                    <option value="Intégration" {% if category_filtre == 'Intégration' %}selected{% endif %}>Intégration</option>
                    <option value="Culture" {% if category_filtre == 'Culture' %}selected{% endif %}>Culture</option>
                    <option value="Sport" {% if category_filtre == 'Sport' %}selected{% endif %}>Sport</option>
                    <option value="Loisirs" {% if category_filtre == 'Loisirs' %}selected{% endif %}>Loisirs</option>
                    <option value="Conférence" {% if category_filtre == 'Conférence' %}selected{% endif %}>Conférence</option>
                </select>
            </div>
            <div class="form-group">
                <select name="statut" class="form-control">
                    <option value="">Tous les statuts</option>
                    <option value="OUVERT" {% if statut_filtre == 'OUVERT' %}selected{% endif %}>Ouverts</option>
                    <option value="COMPLET" {% if statut_filtre == 'COMPLET' %}selected{% endif %}>Complets</option>
                    <option value="ANNULE" {% if statut_filtre == 'ANNULE' %}selected{% endif %}>Annulés</option>
                </select>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn--primary" style="width: 100%;">Filtrer</button>
            </div>
        </form>
    </div>

    <!-- Grille des événements -->
    <div class="events-grid">
        {% for event in events %}
            {% include 'events/_event_card.html.twig' %}
        {% else %}
            <div class="no-events" style="grid-column: 1 / -1; text-align: center; padding: 3rem; background: #F9FAFB; border-radius: var(--radius-lg);">
                <p class="muted">Aucun événement ne correspond à vos critères.</p>
            </div>
        {% endfor %}
    </div>

    <!-- Pagination -->
    {% if totalPages > 1 %}
        <div class="pagination">
            {% if currentPage > 1 %}
                <a href="{{ path('app_events', {page: currentPage - 1, search: search_filtre, category: category_filtre, statut: statut_filtre}) }}" class="btn btn--ghost">&laquo; Précédent</a>
            {% else %}
                <span class="btn btn--ghost" style="opacity: 0.5; pointer-events: none;">&laquo; Précédent</span>
            {% endif %}

            {% for page in 1..totalPages %}
                {% if page == currentPage %}
                    <a href="#" class="btn btn--primary" style="pointer-events: none;">{{ page }}</a>
                {% else %}
                    <a href="{{ path('app_events', {page: page, search: search_filtre, category: category_filtre, statut: statut_filtre}) }}" class="btn btn--ghost">{{ page }}</a>
                {% endif %}
            {% endfor %}

            {% if currentPage < totalPages %}
                <a href="{{ path('app_events', {page: currentPage + 1, search: search_filtre, category: category_filtre, statut: statut_filtre}) }}" class="btn btn--ghost">Suivant &raquo;</a>
            {% else %}
                <span class="btn btn--ghost" style="opacity: 0.5; pointer-events: none;">Suivant &raquo;</span>
            {% endif %}
        </div>
    {% endif %}

</div>
{% endblock %}
