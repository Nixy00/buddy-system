{% extends 'base.html.twig' %}

{% block title %}Modifier le signalement #{{ signalement.id }}{% endblock %}

{% block main %}
<div class="container" style="padding-top: 3rem; max-width: 600px;">
    <div class="page-header" style="margin-bottom: 2rem;">
        <h1 style="font-size: 2rem; color: var(--gray-900); margin-bottom: 0.5rem;">Modifier le signalement</h1>
        <p style="color: var(--gray-600);">Mettez à jour les informations de votre signalement.</p>
    </div>

    {# Rappel du message signalé #}
    <div class="card" style="background: var(--gray-50); padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; border-left: 4px solid var(--color-accent);">
        <p style="margin: 0; font-style: italic; color: var(--gray-700);">"{{ signalement.message.contenu }}"</p>
    </div>

    {{ form_start(form) }}
        <div class="card" style="background: white; padding: 2rem; border-radius: 12px; border: 1px solid var(--gray-200);">
            <div class="form-group">
                {{ form_label(form.motif, null, {'label_attr': {'style': 'font-weight: 600; margin-bottom: 1rem; display: block;'}}) }}

                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                    {% for child in form.motif %}
                        <div class="form-check" style="display: flex; align-items: center; gap: 0.5rem;">
                            {{ form_widget(child) }}
                            {{ form_label(child) }}
                        </div>
                    {% endfor %}
                </div>
                <div style="color: #dc3545; font-size: 0.9rem; margin-top: 0.5rem;">
                    {{ form_errors(form.motif) }}
                </div>
            </div>

            <div class="form-group" style="margin-top: 1.5rem;">
                {{ form_label(form.details, null, {'label_attr': {'style': 'font-weight: 600; margin-bottom: 0.5rem; display: block;'}}) }}
                {{ form_widget(form.details) }}
                <div style="color: #dc3545; font-size: 0.9rem; margin-top: 0.5rem; font-weight: 500;">
                    {{ form_errors(form.details) }}
                </div>
            </div>

            <div style="margin-top: 2rem; display: flex; justify-content: flex-end; gap: 1rem;">
                <a href="{{ path('app_signalement_show', {'id': signalement.id}) }}" class="btn btn--secondary">Annuler</a>
                <button type="submit" class="btn btn--primary">Enregistrer les modifications</button>
            </div>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
