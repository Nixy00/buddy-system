{% extends 'base.html.twig' %}

{% block title %}Consulter les signalements - Buddy System{% endblock %}

{% block main %}
<div class="container" style="padding-top: 3rem; padding-bottom: 4rem; max-width: 800px;">
    <div class="page-header" style="margin-bottom: 2rem;">
        <h1 style="font-size: 2rem; color: var(--gray-900); margin-bottom: 0.5rem;">Consulter les signalements</h1>
        <p style="color: var(--gray-600);">Choisissez le type de signalements que vous souhaitez consulter.</p>
    </div>

    <div class="card" style="background: white; padding: 2rem; border-radius: 12px; border: 1px solid var(--gray-200);">
        <div style="display: flex; flex-direction: column; gap: 1rem;">

            <a href="{{ path('app_signalement_index', {'type': 'message'}) }}" class="btn btn--primary" style="text-align: center; padding: 1rem;">
                Signalements de Messages
            </a>

            <a href="{{ path('app_signalement_index', {'type': 'buddy'}) }}" class="btn btn--primary" style="text-align: center; padding: 1rem;">
                Signalements de Buddies
            </a>

            <a href="{{ path('app_signalement_index', {'type': 'event'}) }}" class="btn btn--primary" style="text-align: center; padding: 1rem;">
                Signalements d'Événements
            </a>

            <a href="{{ path('app_signalement_index', {'type': 'autre'}) }}" class="btn btn--primary" style="text-align: center; padding: 1rem;">
                Signalements Autres (Mot de passe oublié)
            </a>

            {# Ce bouton n'est visible que pour les utilisateurs normaux #}
            {% if not is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_signalement_index') }}" class="btn btn--secondary" style="text-align: center; padding: 1rem; margin-top: 1rem; border-top: 1px solid var(--gray-200); padding-top: 1rem;">
                    Voir tous mes signalements
                </a>
            {% endif %}

        </div>
    </div>

    {# Lien pour les admins vers la liste complète des signalements #}
    {% if is_granted('ROLE_ADMIN') %}
        <div style="text-align: center; margin-top: 3rem; border-top: 1px solid var(--gray-200); padding-top: 2rem;">
            <p style="color: var(--gray-600);">En tant qu'administrateur, vous pouvez consulter la liste de tous les signalements.</p>
            <a href="{{ path('app_signalement_index') }}" class="btn btn--primary" style="background-color: #dc3545;">Accéder à la modération</a>
        </div>
    {% endif %}
</div>
{% endblock %}
