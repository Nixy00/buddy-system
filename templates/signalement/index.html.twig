{% extends 'base.html.twig' %}

{% block title %}Liste des signalements - Buddy System{% endblock %}

{% block main %}
    <div class="container" style="padding-top: 3rem; padding-bottom: 4rem;">
        <div class="page-header" style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1 style="font-size: 2rem; color: var(--gray-900); margin-bottom: 0.5rem;">Signalements</h1>
                <p style="color: var(--gray-600);">Liste de tous les signalements effectués.</p>
            </div>
    </div>

    {% if signalements is empty %}
        <div class="card" style="text-align: center; padding: 3rem; background: var(--gray-50); border: 1px dashed var(--gray-300);">
            <p style="color: var(--gray-500); font-size: 1.1rem;">Aucun signalement pour le moment. Tout va bien ! 🎉</p>
        </div>
    {% else %}
        <div style="display: grid; gap: 1.5rem;">
            {% for signalement in signalements %}
                <div class="card" style="background: white; padding: 1.5rem; border-radius: 12px; border: 1px solid var(--gray-200); display: grid; gap: 1rem;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <span class="badge" style="background: #dc3545; color: white; padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.8rem; font-weight: 600;">
                                {{ signalement.motif }}
                            </span>
                            <span style="color: var(--gray-500); font-size: 0.9rem; margin-left: 0.5rem;">
                                le {{ signalement.dateSignalement|date('d/m/Y à H:i') }}
                            </span>
                        </div>
                        <span class="badge" style="background: var(--gray-100); color: var(--gray-700); padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.8rem;">
                            {{ signalement.statut }}
                        </span>
                    </div>

                    <div style="background: var(--gray-50); padding: 1rem; border-radius: 8px; border-left: 4px solid var(--color-accent);">
                        <p style="margin: 0; color: var(--gray-800); font-style: italic;">"{{ signalement.message.contenu }}"</p>
                        <div style="margin-top: 0.5rem; font-size: 0.85rem; color: var(--gray-500); display: flex; justify-content: space-between;">
                            <span>
                                Auteur du message :
                                <strong>
                                    {% if signalement.message.utilisateur and signalement.message.utilisateur.profil %}
                                        {{ signalement.message.utilisateur.profil.prenom }} {{ signalement.message.utilisateur.profil.nom }}
                                    {% else %}
                                        Utilisateur inconnu
                                    {% endif %}
                                </strong>
                            </span>
                            <span>
                                Signalé par :
                                {% if signalement.utilisateur and signalement.utilisateur.profil %}
                                    {{ signalement.utilisateur.profil.prenom }} {{ signalement.utilisateur.profil.nom }}
                                {% else %}
                                    Utilisateur inconnu
                                {% endif %}
                            </span>
                        </div>
                    </div>

                    <div style="text-align: right;">
                        <a href="{{ path('app_signalement_show', {'id': signalement.id}) }}" class="btn btn--secondary" style="font-size: 0.9rem; padding: 0.5rem 1rem;">
                            Gérer le signalement &rarr;
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
