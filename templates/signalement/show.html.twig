{% extends 'base.html.twig' %}

{% block title %}Détail du signalement #{{ signalement.id }}{% endblock %}

{% block main %}
<div class="container" style="padding-top: 3rem; padding-bottom: 4rem; max-width: 800px;">
    <div class="page-header" style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center;">
        <div>
            <a href="{{ path('app_signalement_index') }}" class="btn btn--ghost" style="margin-bottom: 1rem; display: inline-block;">&larr; Retour à la liste</a>
            <h1 style="font-size: 2rem; color: var(--gray-900); margin: 0;">Signalement #{{ signalement.id }}</h1>
        </div>
        <span class="badge" style="background: var(--gray-100); color: var(--gray-700); padding: 0.5rem 1rem; border-radius: 999px; font-size: 1rem; font-weight: 600;">
            {{ signalement.statut }}
        </span>
    </div>

    <div style="display: grid; gap: 2rem;">
        {# Infos du signalement #}
        <div class="card" style="background: white; padding: 2rem; border-radius: 12px; border: 1px solid var(--gray-200);">
            <h2 style="font-size: 1.25rem; margin-bottom: 1.5rem; color: var(--gray-800);">Informations</h2>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                <div>
                    <strong style="display: block; color: var(--gray-500); font-size: 0.9rem; margin-bottom: 0.25rem;">Motif</strong>
                    <span style="color: #dc3545; font-weight: 600;">{{ signalement.motif }}</span>
                </div>
                <div>
                    <strong style="display: block; color: var(--gray-500); font-size: 0.9rem; margin-bottom: 0.25rem;">Date</strong>
                    <span>{{ signalement.dateSignalement|date('d/m/Y à H:i') }}</span>
                </div>
                <div>
                    <strong style="display: block; color: var(--gray-500); font-size: 0.9rem; margin-bottom: 0.25rem;">Signalé par</strong>
                    {% if signalement.utilisateur and signalement.utilisateur.profil %}
                        <a href="{{ path('app_profil_show', {'id': signalement.utilisateur.profil.id}) }}">
                            {{ signalement.utilisateur.profil.prenom }} {{ signalement.utilisateur.profil.nom }}
                        </a>
                    {% else %}
                        Utilisateur inconnu
                    {% endif %}
                </div>
            </div>
        </div>

        {# Message incriminé #}
        <div class="card" style="background: white; padding: 2rem; border-radius: 12px; border: 1px solid var(--gray-200); border-left: 4px solid var(--color-accent);">
            <h2 style="font-size: 1.25rem; margin-bottom: 1.5rem; color: var(--gray-800);">Message signalé</h2>

            <div style="background: var(--gray-50); padding: 1.5rem; border-radius: 8px;">
                <p style="margin: 0; font-size: 1.1rem; line-height: 1.6; color: var(--gray-900);">"{{ signalement.message.contenu }}"</p>
            </div>

            <div style="margin-top: 1rem; font-size: 0.9rem; color: var(--gray-600);">
                Envoyé par
                <strong>
                    {% if signalement.message.utilisateur and signalement.message.utilisateur.profil %}
                        <a href="{{ path('app_profil_show', {'id': signalement.message.utilisateur.profil.id}) }}">
                            {{ signalement.message.utilisateur.profil.prenom }} {{ signalement.message.utilisateur.profil.nom }}
                        </a>
                    {% else %}
                        Utilisateur inconnu
                    {% endif %}
                </strong>
                le {{ signalement.message.dateEnvoi|date('d/m/Y à H:i') }}
            </div>
        </div>

        {# Réponse de la modération #}
        {% if signalement.commentaireModeration %}
            <div class="card" style="background: #f0fdf4; padding: 2rem; border-radius: 12px; border: 1px solid #bbf7d0; border-left: 4px solid #22c55e;">
                <h2 style="font-size: 1.25rem; margin-bottom: 1.5rem; color: #166534;">Réponse de la modération</h2>
                <p style="margin: 0; font-size: 1.1rem; line-height: 1.6; color: #15803d;">{{ signalement.commentaireModeration|nl2br }}</p>
            </div>
        {% endif %}

        {# Traitement (Admin) #}
        {# TODO: Afficher ce bloc uniquement si l'utilisateur est admin #}
        <div class="card" style="background: white; padding: 2rem; border-radius: 12px; border: 1px solid var(--gray-200);">
            <h2 style="font-size: 1.25rem; margin-bottom: 1.5rem; color: var(--gray-800);">Traitement (Admin)</h2>

            {{ form_start(form) }}
                <div style="display: grid; gap: 1.5rem;">
                    <div class="form-group">
                        {{ form_label(form.statut, null, {'label_attr': {'style': 'font-weight: 600; margin-bottom: 0.5rem; display: block;'}}) }}
                        {{ form_widget(form.statut) }}
                        {{ form_errors(form.statut) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.commentaireModeration, null, {'label_attr': {'style': 'font-weight: 600; margin-bottom: 0.5rem; display: block;'}}) }}
                        {{ form_widget(form.commentaireModeration) }}
                        {{ form_errors(form.commentaireModeration) }}
                    </div>

                    <div style="text-align: right;">
                        <button type="submit" class="btn btn--primary">Enregistrer le traitement</button>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
