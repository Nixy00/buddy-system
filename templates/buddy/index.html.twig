{% extends 'base.html.twig' %}

{% block title %}Rechercher un Buddy{% endblock %}

{% block main %}
    <h1 class="h1">Trouvez votre Buddy</h1>
    
    <div class="search-container" style="margin-bottom: 32px;">
        <div class="search-bar" style="display: flex; gap: 12px; margin-bottom: 16px;">
            <div style="flex: 1; position: relative;">
                <input type="text" placeholder="Rechercher un buddy..." 
                       style="width: 100%; padding: 12px 16px; border: 1px solid var(--gray-300); border-radius: var(--radius); font-size: 1rem;">
            </div>
            <button class="btn btn--primary">
                <span>Rechercher</span>
            </button>
        </div>
    </div>
    
    <div class="buddies-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
        <div class="buddy-card" style="border: 1px solid var(--gray-200); border-radius: var(--radius); overflow: hidden;">
            <div style="height: 120px; background: var(--gray-100); position: relative;">
                <div style="width: 80px; height: 80px; border-radius: 50%; background: var(--gray-300); position: absolute; bottom: -40px; left: 20px; border: 4px solid white;">
                </div>
            </div>
            <div style="padding: 50px 20px 20px;">
                <h3 style="margin: 0 0 4px; font-size: 1.25rem;">Nom Prénom</h3>
                <p style="color: var(--gray-600); margin: 0 0 12px;">Ville, Pays</p>
                <p style="color: var(--gray-700); margin: 0 0 16px; font-size: 0.95rem;">Bio courte...</p>
                <a href="#" class="btn btn--primary" style="display: block; text-align: center;">Voir le profil</a>
            </div>
        </div>
        <div class="buddy-card" style="border: 1px solid var(--gray-200); border-radius: var(--radius); overflow: hidden;">
