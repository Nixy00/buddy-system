{# templates/_navbar.html.twig #}
<header class="site-header">
    <div class="container header__inner">
        <a class="brand" href="{{ path('app_home') }}" aria-label="Buddy System — Accueil">
            <img src="{{ asset('images/logo-urca.png') }}" alt="Logo URCA" style="height: 50px; width: auto; margin-right: 15px;">
            <img src="{{ asset('images/buddy_system_logo.png') }}" alt="Buddy System Logo" class="brand__logo" style="height: 50px; width: auto; margin-right: 15px;">
            <span class="brand__name">Buddy System</span>
        </a>

        <nav class="nav" aria-label="Navigation principale">
            <ul id="menu-principal" class="nav__list">


                {# filtrage des liens selon la connexion #}
                {% if app.user %}
                    <li><a class="nav__link" href="{{ path('app_dashboard') }}">Dashboard</a></li>
                    <li><a class="nav__link" href="{{ path('app_events') }}">Événements</a></li>
                    <li><a class="nav__link" href="{{ path('app_recherche_buddy') }}">Rechercher</a></li>
                    <li><a class="nav__link" href="{{ path('app_messagerie') }}">Messagerie</a></li>
                    <li><a class="nav__link" href="{{ path('app_profil_edit') }}">Mon Profil</a></li>
                {% else %}
                    {# les visiteurs voient seulement : #}
                    <li><a class="nav__link" href="{{ path('app_home') }}">Accueil</a></li>
                    <li><a class="nav__link" href="{{ path('app_events') }}">Événements</a></li>
                    <li><a class="nav__link" href="{{ path('app_recherche_buddy') }}">Rechercher</a></li>
                {% endif %}
            </ul>
        </nav>

        <div class="header__actions">
            {% if app.user %}
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin') }}" title="Espace Administration">
                        <img src="{{ asset('images/modo.png') }}" alt="Admin" style="height: 35px; width: auto; display: block;">
                    </a>
                {% endif %}
                <a class="btn btn--ghost" href="{{ path('app_logout') }}">Déconnexion</a>
            {% else %}
                <a class="btn btn--ghost" href="{{ path('app_login') }}">Connexion</a>
                <a class="btn btn--primary" href="{{ path('app_register') }}">Inscription</a>
            {% endif %}
        </div>
    </div>
</header>
