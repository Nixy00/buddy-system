{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - Buddy System{% endblock %}

{% block main %}
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Mot de passe oublié ?</h1>
            <p class="muted">Remplissez ce formulaire pour envoyer une demande aux administrateurs.</p>
        </div>

        <form method="post">
            <div class="form-group">
                <label for="inputPrenom" class="form-label">Prénom</label>
                <input type="text" name="prenom" id="inputPrenom" class="form-control" required placeholder="Votre prénom">
            </div>

            <div class="form-group">
                <label for="inputNom" class="form-label">Nom</label>
                <input type="text" name="nom" id="inputNom" class="form-control" required placeholder="Votre nom">
            </div>

            <div class="form-group">
                <label for="inputEmail" class="form-label">Email étudiant</label>
                <input type="email" name="email" id="inputEmail" class="form-control" required placeholder="prenom.nom@etudiant.univ-reims.fr">
            </div>

            <button type="submit" class="btn btn--primary btn-block">Envoyer la demande</button>
        </form>

        <div style="text-align: center; margin-top: 1.5rem; font-size: 0.875rem; color: var(--gray-600);">
            <a href="{{ path('app_login') }}" style="color: var(--color-primary); font-weight: 600; text-decoration: none;">&larr; Retour à la connexion</a>
        </div>
    </div>
</div>
{% endblock %}
