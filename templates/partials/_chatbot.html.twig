<div id="chatbot-ui">
    <div id="chatbot-window" class="chatbot-window hidden">
        <div class="chatbot-header">
            <div class="chatbot-title">
                <span class="bot-avatar">🤖</span>
                <div>
                    <span class="bot-name">BuddyBot</span>
                    <span class="bot-status">En ligne</span>
                </div>
            </div>
            <button id="chatbot-close" class="chatbot-close-btn">&times;</button>
        </div>

        <div id="chatbot-messages" class="chatbot-messages">
            <div class="message bot">
                <div class="message-content">
                    Bonjour ! 👋<br>Je suis l'assistant virtuel. Comment puis-je t'aider aujourd'hui ?
                </div>
            </div>
        </div>

        <div class="chatbot-input-area">
            <input type="text" id="chatbot-input" placeholder="Écrivez votre message..." autocomplete="off">
            <button id="chatbot-send-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                </svg>
            </button>
        </div>
    </div>

    <button id="chatbot-toggler" class="chatbot-toggler">
        💬
    </button>
</div>
