{% extends 'base.html.twig' %}

{% block title %}Inscription - Buddy System{% endblock %}

{% block main %}
<div class="auth-page">
    <div class="auth-card auth-card--wide">
        <div class="auth-header">
            <h1>Rejoignez Buddy System</h1>
            <p class="muted">Créez votre compte pour trouver votre binôme.</p>
        </div>

        <form method="post">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                    <label for="inputPrenom" class="form-label">Prénom</label>
                    <input type="text" name="prenom" id="inputPrenom" class="form-control" required placeholder="Ex: Thomas">
                </div>
                <div class="form-group">
                    <label for="inputNom" class="form-label">Nom</label>
                    <input type="text" name="nom" id="inputNom" class="form-control" required placeholder="Ex: Dupont">
                </div>
            </div>


            <div class="form-group">
                <label class="form-label">Type d'étudiant</label>
                <div style="display: flex; gap: 1rem;">
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                        <input type="radio" name="type_compte" value="Local" required> <span>Local</span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                        <input type="radio" name="type_compte" value="International" required> <span>International</span>
                    </label>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                    <label for="inputGenre" class="form-label">Genre</label>
                    <select name="genre" id="inputGenre" class="form-control" required>
                        <option value="">Sélectionner...</option>
                        <option value="Homme">Homme</option>
                        <option value="Femme">Femme</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="inputDateNaissance" class="form-label">Date de naissance</label>
                    <input type="date" name="date_naissance" id="inputDateNaissance" class="form-control" required>
                </div>
            </div>

            <div class="form-group">
                <label for="inputEmail" class="form-label">Email étudiant (URCA)</label>
                <input type="email" name="email" id="inputEmail" class="form-control" required placeholder="prenom.nom@etudiant.univ-reims.fr">
                <small class="muted" style="display: block; margin-top: 0.25rem;">Nous utilisons votre email universitaire pour vérifier votre statut.</small>
            </div>

            <div class="form-group">
                <label for="inputPassword" class="form-label">Mot de passe</label>
                <div style="position: relative;">
                    <input type="password" name="password" id="inputPassword" class="form-control" required placeholder="Minimum 8 caractères" style="padding-right: 40px;">
                    <button type="button" class="toggle-password" data-target="inputPassword" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer;">
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label for="inputPasswordConfirm" class="form-label">Confirmer le mot de passe</label>
                <div style="position: relative;">
                    <input type="password" name="password_confirm" id="inputPasswordConfirm" class="form-control" required placeholder="Répétez votre mot de passe" style="padding-right: 40px;">
                    <button type="button" class="toggle-password" data-target="inputPasswordConfirm" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer;">
                    </button>
                </div>
                <div id="passwordError" style="color: #dc3545; font-size: 0.875rem; margin-top: 0.5rem; display: none;">
                    Les deux mots de passe ne correspondent pas
                </div>
            </div>

            <script>
                const passwordInput = document.getElementById('inputPassword');
                const passwordConfirmInput = document.getElementById('inputPasswordConfirm');
                const passwordError = document.getElementById('passwordError');
                const submitButton = document.querySelector('button[type="submit"]');

                function checkPasswords() {
                    if (passwordConfirmInput.value && passwordInput.value !== passwordConfirmInput.value) {
                        passwordError.style.display = 'block';
                        submitButton.disabled = true;
                        submitButton.style.opacity = '0.6';
                        submitButton.style.cursor = 'not-allowed';
                    } else {
                        passwordError.style.display = 'none';
                        submitButton.disabled = false;
                        submitButton.style.opacity = '1';
                        submitButton.style.cursor = 'pointer';
                    }
                }

                passwordInput.addEventListener('input', checkPasswords);
                passwordConfirmInput.addEventListener('input', checkPasswords);
            </script>

            <div class="form-group" style="margin-bottom: 2rem;">
                <label style="display: flex; gap: 0.5rem; align-items: start; font-size: 0.875rem;">
                    <input type="checkbox" required style="margin-top: 0.25rem;">
                    <span>J'accepte les <a href="#" style="color: var(--color-primary);">Conditions Générales d'Utilisation</a> et la <a href="#" style="color: var(--color-primary);">Politique de Confidentialité</a>.</span>
                </label>
            </div>

            <button type="submit" class="btn btn--primary btn-block">Créer mon compte</button>
        </form>

        <div style="text-align: center; margin-top: 1.5rem; font-size: 0.875rem; color: var(--gray-600);">
            Déjà inscrit ? <a href="{{ path('app_login') }}" style="color: var(--color-primary); font-weight: 600; text-decoration: none;">Se connecter</a>
        </div>
    </div>
</div>
{% endblock %}
