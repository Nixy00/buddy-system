<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="Buddy System - Plateforme de parrainage entre étudiants locaux et internationaux de l'URCA">
        <title>{% block title %}Buddy System{% endblock %} - URCA</title>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <a class="skiplink" href="#contenu">Aller au contenu</a>

        {% include '_navbar.html.twig' %}

        <main id="contenu" class="container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block main %}{% endblock %}
        </main>
    </body>
</html>
