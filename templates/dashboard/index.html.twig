{% extends 'base.html.twig' %}

{% block title %}Dashboard - Buddy System{% endblock %}

{% block main %}
<section class="section dashboard-content">
    <div class="container">
        {# Message de bienvenue personnalisé avec le prénom de l'utilisateur #}
        <h1 class="h1">Bienvenue, {{ user.profil.prenom }} 👋</h1>
        <p class="lead">
            Voici votre tableau de bord. Accédez rapidement aux principales fonctionnalités :
        </p>

        {# Grille de 4 cartes pour accéder aux différentes sections #}
        <ul class="cards" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; list-style: none; padding: 0; margin: 2rem 0;">

            {# Carte Mon Profil #}
            <li class="card" style="border: 1px solid var(--gray-200); border-radius: var(--radius); padding: 1.5rem; background: white;">
                <h3 style="margin: 0 0 0.5rem; color: var(--gray-900);">Mon Profil</h3>
                <p style="color: var(--gray-600); margin: 0 0 1rem;">
                    Consultez et modifiez vos informations personnelles.
                </p>
                <a href="{{ path('app_profil_show', {id: user.profil.id}) }}" class="card__link"
                   style="color: var(--color-accent); text-decoration: none; font-weight: 500;">
                    Voir mon profil →
                </a>
            </li>

            {# Carte Mes Buddies #}
            <li class="card" style="border: 1px solid var(--gray-200); border-radius: var(--radius); padding: 1.5rem; background: white; display: flex; flex-direction: column;">
                <h3 style="margin: 0 0 0.5rem; color: var(--gray-900);">Mes Buddies</h3>

                <p style="color: var(--gray-600); margin: 0 0 1rem; flex-grow: 1;">
                    {% if buddyCount == 0 %}
                        Vous n'avez pas encore de buddy. Lancez une recherche !
                    {% else %}
                        Vous êtes en relation avec <strong>{{ buddyCount }} {{ buddyCount > 1 ? 'buddies' : 'buddy' }}</strong>.
                    {% endif %}
                </p>

                <div style="display: flex; gap: 15px; align-items: center; justify-content: space-between;">
                    <a href="{{ path('app_dashboard_mes_buddies') }}" class="card__link"
                       style="color: var(--color-accent); text-decoration: none; font-weight: 500;">
                        Voir mes buddies →
                    </a>
                </div>
            </li>

            {# Carte Messagerie #}
            <li class="card" style="border: 1px solid var(--gray-200); border-radius: var(--radius); padding: 1.5rem; background: white;">
                <h3 style="margin: 0 0 0.5rem; color: var(--gray-900);">Messagerie</h3>
                <p style="color: var(--gray-600); margin: 0 0 1rem;">
                    Échangez avec vos buddies et retrouvez vos signalements.
                </p>
                <a href="{{ path('app_messagerie') }}" class="card__link"
                   style="color: var(--color-accent); text-decoration: none; font-weight: 500;">
                    Voir ma messagerie →
                </a>
            </li>

            {# Carte Mes Événements #}
            <li class="card" style="border: 1px solid var(--gray-200); border-radius: var(--radius); padding: 1.5rem; background: white;">
                <h3 style="margin: 0 0 0.5rem; color: var(--gray-900);">Mes Événements</h3>
                <p style="color: var(--gray-600); margin: 0 0 1rem;">
                    {% if mesParticipations is empty %}
                        Vous n'êtes inscrit à aucun événement pour le moment.
                    {% else %}
                        Vous participez à <strong>{{ mesParticipations|length }} événement{{ mesParticipations|length > 1 ? 's' : '' }}</strong>.
                    {% endif %}
                </p>
                <a href="{{ path('app_dashboard_mes_evenements') }}" class="card__link"
                   style="color: var(--color-accent); text-decoration: none; font-weight: 500;">
                    Voir mes événements →
                </a>
            </li>

        </ul>

        {# Lien vers la page de confirmation de suppression #}
        <div style="text-align: right; margin-top: 3rem;">
            <a href="{{ path('app_account_confirm_delete') }}" class="btn" style="background-color: #dc3545; color: white; border: none; text-decoration: none;">
                Supprimer mon compte
            </a>
        </div>
    </div>
</section>
{% endblock %}
