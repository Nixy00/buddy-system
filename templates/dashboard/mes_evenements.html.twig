{% extends 'base.html.twig' %}

{% block title %}Mes Événements - Buddy System{% endblock %}

{% block main %}
<section class="section">
    <div class="container">
        <h1 class="h1">Mes Événements</h1>

        {% if mesParticipations is empty %}
            <div style="text-align: center; padding: 3rem; background: #f8f9fa; border-radius: 8px; margin-top: 2rem;">
                <p style="color: #6c757d; font-size: 1.1rem; margin-bottom: 1.5rem;">
                    Vous n'êtes inscrit à aucun événement pour le moment.
                </p>
                <a href="{{ path('app_events') }}" class="btn btn--primary" style="text-decoration: none;">
                    Découvrir les événements →
                </a>
            </div>
        {% else %}
            <p class="lead" style="margin-top: 1rem; margin-bottom: 2rem;">
                Vous participez à {{ mesParticipations|length }} événement{{ mesParticipations|length > 1 ? 's' : '' }}.
            </p>

            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
                {% for participation in mesParticipations %}
                    {% set evenement = participation.evenement %}
                    {{ include('events/_event_card.html.twig', {event: evenement}) }}
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
