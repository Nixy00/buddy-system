{% extends 'base.html.twig' %}

{% block title %}Accueil - Buddy System{% endblock %}

{% block main %}
<div style="text-align: center; padding: 4rem 2rem;">
    <h1>Bienvenue sur Buddy System</h1>
    <p class="muted">Ceci est une page de test pour valider la structure globale.</p>
    
    <div style="margin-top: 2rem;">
        <button class="btn btn--primary">Bouton Principal</button>
