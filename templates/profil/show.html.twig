{% extends 'base.html.twig' %}

{% block title %}{{ profil.prenom }} {{ profil.nom }} - Buddy System{% endblock %}

{% block main %}
    <div class="breadcrumb" style="background: white; padding: 12px 0; border-bottom: 1px solid var(--gray-200); font-size: 0.9rem;">
        <div class="container">
            <a href="{{ path('app_home') }}" style="color: var(--gray-500); text-decoration: none;">Accueil</a>
            <span style="color: var(--gray-400); margin: 0 8px;">/</span>
            <a href="{{ path('app_recherche_buddy') }}" style="color: var(--gray-500); text-decoration: none;">Rechercher un Buddy</a>
            <span style="color: var(--gray-400); margin: 0 8px;">/</span>
            <span style="color: var(--gray-900);">{{ profil.prenom }} {{ profil.nom }}</span>
        </div>
    </div>

    <div class="profile-header" style="background: white; padding: 40px 0; margin-bottom: 30px; border-bottom: 1px solid var(--gray-200);">
        <div class="container">
            <div style="display: flex; flex-direction: column; align-items: center; text-align: center;">
                {# Avatar #}
                {% if profil.avatar %}
                    <img
                        src="{{ path('app_profil_avatar', { id: profil.id }) }}"
                        alt="Avatar de {{ profil.prenom }} {{ profil.nom }}"
                        style="width: 20%; height: 20%; object-fit: cover; border-radius: 50%; display: block;"
                    >
                {% else %}
                    <span style="font-size: 3rem; color: var(--color-primary); font-weight: 600;">
                        {{ profil.prenom|first }}{{ profil.nom|first }}
                    </span>
                {% endif %}


                {# Nom et Âge #}
                <h1 style="color: var(--gray-900); margin: 0 0 8px; font-size: 2rem;">
                    {{ profil.prenom }} {{ profil.nom }}
                </h1>

                <div style="color: var(--gray-600); margin-bottom: 16px; font-size: 1.1rem; display: flex; align-items: center; gap: 8px;">
                    <span>{{ "now"|date("Y") - profil.dateNaissance|date("Y") }} ans</span>
                    <span style="width: 4px; height: 4px; background: var(--gray-400); border-radius: 50%;"></span>
                    {% if profil.ville and profil.pays %}
                        <span><i class="fas fa-map-marker-alt" style="color: var(--color-primary);"></i> {{ profil.ville }}, {{ profil.pays }}</span>
                    {% elseif profil.ville %}
                        <span><i class="fas fa-map-marker-alt" style="color: var(--color-primary);"></i> {{ profil.ville }}</span>
                    {% endif %}
                </div>

                {# Actions (Centrées et Stylisées) #}
                <div class="profile-actions" style="display: flex; gap: 16px; margin-bottom: 30px;">
                    <a href="{{ app.user ? path('app_messagerie_start', {id: profil.utilisateur.id}) : path('app_login') }}"
                       class="btn btn--primary"
                       style="padding: 12px 24px; border-radius: 30px; display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-envelope"></i> Envoyer un message
                    </a>
                    <a href="{{ app.user ? '#' : path('app_login') }}" class="btn btn--secondary" style="padding: 12px 24px; border-radius: 30px; display: flex; align-items: center; gap: 8px; background: white; border: 1px solid var(--color-primary); color: var(--color-primary);">
                        <i class="fas fa-user-plus"></i> Demander en Buddy
                    </a>
                </div>

                {# Stats #}
                <div class="profile-stats" style="display: flex; gap: 40px; border-top: 1px solid var(--gray-200); padding-top: 24px;">
                    <div style="text-align: center;">
                        <span style="display: block; font-size: 1.5rem; font-weight: 700; color: var(--gray-900);">0</span>
                        <span style="display: block; font-size: 0.9rem; color: var(--gray-500);">Buddies</span>
                    </div>
                    <div style="text-align: center;">
                        <span style="display: block; font-size: 1.5rem; font-weight: 700; color: var(--gray-900);">{{ profil.utilisateur.participations|length }}</span>
                        <span style="display: block; font-size: 0.9rem; color: var(--gray-500);">Événements</span>
                    </div>
                    <div style="text-align: center;">
                        <span style="display: block; font-size: 1.5rem; font-weight: 700; color: var(--gray-900);">
                            {% if profil.langues %}{{ profil.langues|split(',')|length }}{% else %}0{% endif %}
                        </span>
                        <span style="display: block; font-size: 0.9rem; color: var(--gray-500);">Langues</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container" style="padding-bottom: 60px;">
        <div style="display: grid; gap: 24px; max-width: 800px; margin: 0 auto;">
            {# Section 1 : Biographie #}
            <div class="profile-section" style="background: white; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid var(--gray-100);">
                <h2 class="section-title" style="font-size: 1.25rem; font-weight: 600; color: var(--gray-900); margin: 0 0 16px; display: flex; align-items: center; gap: 10px;">
                    <i class="fas fa-user-circle" style="color: var(--color-primary);"></i>
                    À propos
                </h2>
                {% if profil.biographie %}
                    <p style="color: var(--gray-700); line-height: 1.6; margin: 0;">{{ profil.biographie }}</p>
                {% else %}
                    <p style="color: var(--gray-500); font-style: italic; margin: 0;">Aucune présentation renseignée.</p>
                {% endif %}
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                {# Section 2 : Langues #}
                <div class="profile-section" style="background: white; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid var(--gray-100);">
                    <h2 class="section-title" style="font-size: 1.1rem; font-weight: 600; color: var(--gray-900); margin: 0 0 16px; display: flex; align-items: center; gap: 10px;">
                        <i class="fas fa-language" style="color: var(--color-primary);"></i>
                        Langues
                    </h2>
                    {% if profil.langues %}
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            {% for langue in profil.langues|split(',') %}
                                <span style="background: var(--gray-50); color: var(--gray-800); padding: 6px 12px; border-radius: 20px; font-weight: 500; font-size: 0.85rem; border: 1px solid var(--gray-200);">
                                    {{ langue|trim }}
                                </span>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p style="color: var(--gray-500); font-style: italic; margin: 0;">Non renseigné.</p>
                    {% endif %}
                </div>

                {# Section 3 : Disponibilités #}
                <div class="profile-section" style="background: white; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid var(--gray-100);">
                    <h2 class="section-title" style="font-size: 1.1rem; font-weight: 600; color: var(--gray-900); margin: 0 0 16px; display: flex; align-items: center; gap: 10px;">
                        <i class="fas fa-calendar-alt" style="color: var(--color-primary);"></i>
                        Disponibilités
                    </h2>
                    {% if profil.disponibilites %}
                        <div style="font-size: 0.95rem; color: var(--gray-800);">
                            {{ profil.disponibilites }}
                        </div>
                    {% else %}
                        <p style="color: var(--gray-500); font-style: italic; margin: 0;">Non renseigné.</p>
                    {% endif %}
                </div>
            </div>

            {# Section 4 : Infos Techniques (Footer Profil) #}
            <div style="text-align: center; margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--gray-200); color: var(--gray-500); font-size: 0.9rem;">
                <p style="margin: 0 0 5px;">
                    Sur Buddy System depuis le {{ profil.dateCrea|date('d/m/Y') }}
                </p>
                {% if profil.utilisateur %}
                    <p style="margin: 0; opacity: 0.7; font-size: 0.8rem;">
                        ID Utilisateur: #{{ profil.utilisateur.id }}
                    </p>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
