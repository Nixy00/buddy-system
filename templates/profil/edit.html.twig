{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block main %}
{# Container principal avec classe de la maquette #}
<main class="profile-container">
    {# En-tête de la page #}
    <div class="profile-header">
        <h1 class="h1">Mon Profil</h1>
        <p>Gérez vos informations personnelles et vos préférences</p>
    </div>

    {# Formulaire d'édition #}
    <form class="profile-form">
        
        {# Section Photo de profil #}
        <div class="form-section">
            <div class="avatar-upload">
                <img src="https://via.placeholder.com/120" alt="Photo de profil" class="profile-avatar">
                <label class="avatar-label">
                    Changer la photo
                    {# TODO BACKEND: Upload avatar fonctionnel (champ BLOB dans Profil) #}
                </label>
                <input type="file" accept="image/*" style="display: none;">
            </div>
        </div>

        {# Section Informations personnelles #}
        <div class="form-section">
            <h2>Informations personnelles</h2>
            
            {# Ligne 1 : Prénom et Nom (champs Profil.prenom et Profil.nom) #}
            <div class="form-row">
                <div class="form-group">
                    <label for="prenom">Prénom</label>
                    <input type="text" id="prenom" name="prenom" class="form-control" required>
                </div>
                <div class="form-group">
                    <label for="nom">Nom</label>
                    <input type="text" id="nom" name="nom" class="form-control" required>
                </div>
            </div>
            
            {# Téléphone (champ Profil.telephone, nullable) #}
            <div class="form-group">
                <label for="telephone">Téléphone</label>
                <input type="tel" id="telephone" name="telephone" class="form-control" 
                       placeholder="06 12 34 56 78" maxlength="15">
            </div>

            {# Date de naissance (champ Profil.dateNaissance) #}
            <div class="form-group">
                <label for="dateNaissance">Date de naissance</label>
                <input type="date" id="dateNaissance" name="dateNaissance" class="form-control" required>
            </div>

            {# Genre (champ Profil.genre) #}
            <div class="form-group">
                <label>Genre</label>
                <div class="radio-group">
                    <label>
                        <input type="radio" name="genre" value="homme" checked> Homme
                    </label>
                    <label>
                        <input type="radio" name="genre" value="femme"> Femme
                    </label>
                    <label>
                        <input type="radio" name="genre" value="autre"> Autre
                    </label>
                </div>
            </div>
        </div>

        {# Section À propos de moi (champ Profil.biographie, max 500 caractères) #}
        <div class="form-section">
            <h2>À propos de moi</h2>
            <div class="form-group">
                <label for="biographie">Présentation</label>
                <textarea id="biographie" name="biographie" class="form-control" rows="4" 
                          maxlength="500"
                          placeholder="Parlez-nous un peu de vous..."></textarea>
                <small class="muted">Maximum 500 caractères</small>
            </div>
        </div>

        {# Section Langues parlées (champ Profil.langues, stocké comme string) #}
        <div class="form-section">
            <h2>Langues parlées</h2>
            <div class="form-group">
                <label for="langues">Langues</label>
                <input type="text" id="langues" name="langues" class="form-control" 
                       placeholder="Ex: Français, Anglais, Espagnol" maxlength="255">
                <small class="muted">Séparez les langues par des virgules</small>
            </div>
            {# TODO BACKEND: Système de tags dynamiques sera mieux qu'un champ texte #}
        </div>

        {# Section Localisation (champs Profil.pays et Profil.ville) #}
        <div class="form-section">
            <h2>Localisation</h2>
            <div class="form-row">
                <div class="form-group">
                    <label for="pays">Pays</label>
                    <input type="text" id="pays" name="pays" class="form-control" 
                           placeholder="France" maxlength="100">
                </div>
                <div class="form-group">
                    <label for="ville">Ville</label>
                    <input type="text" id="ville" name="ville" class="form-control" 
                           placeholder="Paris" maxlength="100">
                </div>
            </div>
        </div>

        {# Boutons Annuler / Enregistrer #}
        <div class="form-section" style="text-align: right;">
            <a href="{{ path('app_dashboard') }}" class="btn btn--ghost" style="margin-right: 1rem;">Annuler</a>
            <button type="button" class="btn-save" disabled 
                    title="La sauvegarde sera implémentée par le backend">
                Enregistrer les modifications
            </button>
        </div>
    </form>
</main>

{# Note pour le backend :
   - Email : dans User.email (pas dans Profil)
   - TypeCompte : dans Profil.typeCompte (pas géré par formulaire utilisateur)
   - Disponibilites : dans Profil.disponibilites (pas dans ce formulaire)
   - DateCrea, DateModif : gérés automatiquement
#}
{% endblock %}
