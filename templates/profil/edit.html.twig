{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block main %}
<div class="container" style="padding-top: 3rem; padding-bottom: 4rem;">
    <div class="page-header" style="margin-bottom: 2rem;">
        <h1 style="font-size: 2rem; color: var(--gray-900); margin-bottom: 0.5rem;">Modifier mon profil</h1>
        <p style="color: var(--gray-600);">Mettez à jour vos informations personnelles.</p>
    </div>

    {{ form_start(form) }}
        {# Affichage des erreurs globales du formulaire #}
        {{ form_errors(form) }}

        <div style="display: grid; gap: 2rem; max-width: 800px; margin: 0 auto;">

            {# Section 1: Informations Personnelles #}
            <div class="profile-section" style="background: white; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid var(--gray-100);">
                <h2 class="section-title" style="font-size: 1.25rem; font-weight: 600; color: var(--gray-900); margin: 0 0 24px;">
                    Informations Personnelles
                </h2>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    {{ form_row(form.nom) }}
                    {{ form_row(form.prenom) }}
                    {{ form_row(form.genre) }}
                    {{ form_row(form.dateNaissance) }}
                    {{ form_row(form.telephone) }}
                    {{ form_row(form.ville) }}
                    {{ form_row(form.pays) }}
                </div>
            </div>

            {# Section 2: Détails #}
            <div class="profile-section" style="background: white; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid var(--gray-100);">
                <h2 class="section-title" style="font-size: 1.25rem; font-weight: 600; color: var(--gray-900); margin: 0 0 24px;">
                    Détails
                </h2>
                <div style="display: grid; gap: 20px;">
                    {# Modification pour la biographie #}
                    <div class="form-group">
                        {{ form_label(form.biographie) }}
                        {{ form_widget(form.biographie, {'attr': {'style': 'resize: none;'}}) }}
                        {{ form_errors(form.biographie) }}
                    </div>

                    {# Affichage des checkboxes pour les langues #}
                    <div class="form-group">
                        {{ form_label(form.langues) }}
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 10px; margin-top: 8px;">
                            {% for child in form.langues %}
                                <div class="form-check" style="display: flex; align-items: center; gap: 8px;">
                                    {{ form_widget(child, {'attr': {'style': 'width: 16px; height: 16px; cursor: pointer;'}}) }}
                                    {{ form_label(child, null, {'label_attr': {'style': 'cursor: pointer; margin-bottom: 0;'}}) }}
                                </div>
                            {% endfor %}
                        </div>
                        {{ form_errors(form.langues) }}
                    </div>

                    {# Affichage des checkboxes pour les disponibilités #}
                    <div class="form-group">
                        {{ form_label(form.disponibilites) }}
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; margin-top: 8px;">
                            {% for child in form.disponibilites %}
                                <div class="form-check" style="display: flex; align-items: center; gap: 8px;">
                                    {{ form_widget(child, {'attr': {'style': 'width: 16px; height: 16px; cursor: pointer;'}}) }}
                                    {{ form_label(child, null, {'label_attr': {'style': 'cursor: pointer; margin-bottom: 0;'}}) }}
                                </div>
                            {% endfor %}
                        </div>
                        {{ form_errors(form.disponibilites) }}
                    </div>
                </div>
            </div>

            {# Section 3: Avatar #}
            <div class="profile-section" style="background: white; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid var(--gray-100);">
                <h2 class="section-title" style="font-size: 1.25rem; font-weight: 600; color: var(--gray-900); margin: 0 0 24px;">
                    Photo de profil
                </h2>

                {# Affichage de l'avatar actuel #}
                {% if user.profil and user.profil.avatar %}
                    <div style="margin-bottom: 1rem;">
                        <p>Avatar actuel :</p>
                        <img src="{{ path('app_profil_avatar', {id: user.profil.id}) }}" alt="Avatar actuel" style="max-width: 150px; height: auto; border-radius: 8px;">
                    </div>
                {% endif %}

                {{ form_row(form.avatar) }}
            </div>

            {# Actions #}
            <div class="form-actions" style="display: flex; justify-content: flex-end; gap: 16px; padding-top: 10px;">
                <a href="{{ path('app_profil_show', {'id': user.profil.id}) }}" class="btn btn--secondary" style="padding: 12px 24px; border-radius: 30px; border: 1px solid var(--gray-300); color: var(--gray-700); background: white; text-decoration: none; font-weight: 500;">
                    Annuler
                </a>
                <button type="submit" class="btn btn--primary" style="padding: 12px 32px; border-radius: 30px;">
                    Enregistrer les modifications
                </button>
            </div>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
