{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block main %}
{# Container principal avec classe de la maquette #}
<main class="profile-container">
    {# En-tête de la page #}
    <div class="profile-header">
        <h1 class="h1">Mon Profil</h1>
        <p>Gérez vos informations personnelles et vos préférences</p>
    </div>

    {# Formulaire d'édition #}
    <form class="profile-form">
        
        {# Section Photo de profil #}
        <div class="form-section">
            <div class="avatar-upload">
                <img src="https://via.placeholder.com/120" alt="Photo de profil" class="profile-avatar">
                <label class="avatar-label">
                    Changer la photo
                    {# TODO BACKEND: Upload avatar fonctionnel #}
                </label>
                <input type="file" accept="image/*" style="display: none;">
            </div>
        </div>

        {# Section Informations personnelles #}
        <div class="form-section">
            <h2>Informations personnelles</h2>
            
            {# Ligne 1 : Prénom et Nom #}
            <div class="form-row">
                <div class="form-group">
                    <label for="prenom">Prénom</label>
                    <input type="text" id="prenom" class="form-control" required>
                </div>
                <div class="form-group">
                    <label for="nom">Nom</label>
                    <input type="text" id="nom" class="form-control" required>
                </div>
            </div>
            
            {# Ligne 2 : Email et Téléphone #}
            <div class="form-row">
                <div class="form-group">
                    <label for="email">Adresse email</label>
                    <input type="email" id="email" class="form-control" required>
                </div>
                <div class="form-group">
                    <label for="telephone">Téléphone</label>
                    <input type="tel" id="telephone" class="form-control">
                </div>
            </div>

            {# Date de naissance #}
            <div class="form-group">
                <label for="dateNaissance">Date de naissance</label>
                <input type="date" id="dateNaissance" class="form-control">
            </div>

            {# Genre avec boutons radio #}
            <div class="form-group">
                <label>Genre</label>
                <div class="radio-group">
                    <label>
                        <input type="radio" name="genre" value="homme" checked> Homme
                    </label>
                    <label>
                        <input type="radio" name="genre" value="femme"> Femme
                    </label>
                    <label>
                        <input type="radio" name="genre" value="autre"> Autre
                    </label>
                </div>
            </div>
        </div>

        {# Section À propos de moi #}
        <div class="form-section">
            <h2>À propos de moi</h2>
            <div class="form-group">
                <label for="bio">Présentation</label>
                <textarea id="bio" class="form-control" rows="4" 
                          placeholder="Parlez-nous un peu de vous..."></textarea>
            </div>
        </div>

        {# Section Langues parlées #}
        <div class="form-section">
            <h2>Langues parlées</h2>
            <div class="form-group">
                <label for="languageSelect">Sélectionnez une langue</label>
                <select id="languageSelect" class="form-control">
                    <option value="">Sélectionnez une langue</option>
                    <option value="francais">Français</option>
                    <option value="anglais">Anglais</option>
                    <option value="espagnol">Espagnol</option>
                    <option value="allemand">Allemand</option>
                    <option value="italien">Italien</option>
                    <option value="chinois">Chinois</option>
                    <option value="arabe">Arabe</option>
                    <option value="russe">Russe</option>
                    <option value="portugais">Portugais</option>
                    <option value="japonais">Japonais</option>
                </select>
            </div>
            {# TODO BACKEND: Système de tags dynamiques pour sélectionner plusieurs langues #}
        </div>

        {# Section Localisation #}
        <div class="form-section">
            <h2>Localisation</h2>
            <div class="form-row">
                <div class="form-group">
                    <label for="pays">Pays</label>
                    <select id="pays" class="form-control">
                        <option value="">Sélectionnez un pays</option>
                        <option value="france">France</option>
                        <option value="belgique">Belgique</option>
                        <option value="suisse">Suisse</option>
                        <option value="canada">Canada</option>
                        <option value="autre">Autre</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="ville">Ville</label>
                    <input type="text" id="ville" class="form-control">
                </div>
            </div>
        </div>

        {# Boutons Annuler / Enregistrer #}
        <div class="form-section" style="text-align: right;">
            <a href="{{ path('app_dashboard') }}" class="btn btn--ghost" style="margin-right: 1rem;">Annuler</a>
            <button type="button" class="btn-save" disabled 
                    title="La sauvegarde sera implémentée par le backend">
                Enregistrer les modifications
            </button>
        </div>
    </form>
</main>
{% endblock %}
