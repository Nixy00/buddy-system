{% extends 'base.html.twig' %}

{% block title %}Archives - Buddy System{% endblock %}

{% block main %}
    <div class="container" style="padding-top: 2rem; max-width: 900px;">
        <div class="page-header" style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1>Conversations archivées</h1>
                <a href="{{ path('app_messagerie') }}" class="btn btn--ghost" style="padding: 0;">&larr; Retour aux messages</a>
            </div>
        </div>

        <div class="conversations-list" style="display: flex; flex-direction: column; gap: 1rem;">
            {% for conversation in conversations %}
                {% set contact = (conversation.initiateur == app.user) ? conversation.interlocuteur : conversation.initiateur %}

                <div class="card conversation-card" style="display: flex; align-items: center; gap: 1rem; padding: 1.5rem; background: #f8f9fa;">

                    <a href="{{ path('app_messagerie_show', {id: conversation.id}) }}" style="display: flex; align-items: center; gap: 1rem; flex-grow: 1; text-decoration: none; color: inherit; opacity: 0.7;">
                        <div class="avatar" style="width: 50px; height: 50px; flex-shrink: 0;">
                            {% if contact.profil.avatar %}
                                <img src="{{ path('app_profil_avatar', {id: contact.profil.id}) }}" alt="{{ contact.profil.prenom }}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
                            {% else %}
                                <div style="width: 100%; height: 100%; background: var(--gray-200); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; color: var(--gray-600);">
                                    {{ contact.profil.prenom|first }}{{ contact.profil.nom|first }}
                                </div>
                            {% endif %}
                        </div>
                        <div>
                            <h3 style="margin: 0; font-size: 1.1rem;">{{ contact.profil.prenom }} {{ contact.profil.nom }}</h3>
                        </div>
                    </a>

                    <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 5px;">
                        <a href="{{ path('app_conversation_unarchive', {id: conversation.id}) }}" class="btn btn-sm btn-outline-primary" style="font-size: 0.8rem;">
                            <i class="fas fa-box-open"></i> Désarchiver
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="empty-state" style="text-align: center; padding: 3rem;">
                    <p class="muted">Aucune conversation archivée.</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
