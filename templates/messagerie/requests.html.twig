{% extends 'base.html.twig' %}

{% block title %}Demandes de Buddy - Messagerie{% endblock %}

{% block main %}
<div class="container" style="padding-top: 2rem; max-width: 800px;">
    <div class="page-header" style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h1>Demandes de Buddy</h1>
            <p class="muted">Gérez ici les demandes que vous avez reçues.</p>
        </div>
        <a href="{{ path('app_messagerie') }}" class="btn btn--secondary">Retour aux conversations</a>
    </div>

    <div class="requests-list" style="display: flex; flex-direction: column; gap: 1rem;">
        {% for request in buddyRequests %}
            <div class="card request-card" style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.5rem;">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <a href="{{ path('app_profil_show', {id: request.envoyeur.profil.id}) }}">
                        <div class="avatar" style="width: 50px; height: 50px; flex-shrink: 0;">
                            {% if request.envoyeur.profil.avatar %}
                                <img src="{{ path('app_profil_avatar', {id: request.envoyeur.profil.id}) }}" alt="{{ request.envoyeur.profil.prenom }}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
                            {% else %}
                                <div style="width: 100%; height: 100%; background: var(--gray-200); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; color: var(--gray-600);">
                                    {{ request.envoyeur.profil.prenom|first }}{{ request.envoyeur.profil.nom|first }}
                                </div>
                            {% endif %}
                        </div>
                    </a>
                    <div>
                        <a href="{{ path('app_profil_show', {id: request.envoyeur.profil.id}) }}" style="font-weight: bold; text-decoration: none; color: inherit;">
                            {{ request.envoyeur.profil.prenom }} {{ request.envoyeur.profil.nom }}
                        </a>
                        <span class="muted">vous a envoyé une demande.</span>
                        <div class="muted" style="font-size: 0.85rem;">{{ request.dateDemande|date('d/m/Y à H:i') }}</div>
                    </div>
                </div>
                <div style="display: flex; gap: 0.5rem;">
                    <a href="{{ path('app_relation_accept_request', {id: request.id}) }}" class="btn btn--success">Accepter</a>
                    <a href="{{ path('app_relation_refuse_request', {id: request.id}) }}" class="btn btn--danger">Refuser</a>
                </div>
            </div>
        {% else %}
            <div class="empty-state" style="text-align: center; padding: 3rem; background: var(--gray-100); border-radius: 12px;">
                <p class="muted">Vous n'avez aucune demande de buddy en attente.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
