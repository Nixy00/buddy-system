{% extends 'base.html.twig' %}

{% block title %}Discussion avec {{ contact.profil.prenom }} - Buddy System{% endblock %}

{% block main %}
    <div class="container" style="padding-top: 2rem; max-width: 800px;">
        {# en-tête #}
        <div class="chat-header" style="display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--gray-200);">
            <a href="{{ path('app_messagerie') }}" class="btn btn--ghost" style="padding: 0.5rem;">&larr; Retour</a>

            <div class="avatar" style="width: 40px; height: 40px;">
                {% if contact.profil.avatar %}
                    <img src="{{ path('app_profil_avatar', {id: contact.profil.id}) }}" alt="{{ contact.profil.prenom }}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
                {% else %}
                    <div style="width: 100%; height: 100%; background: var(--gray-200); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; color: var(--gray-600);">
                        {{ contact.profil.prenom|first }}{{ contact.profil.nom|first }}
                    </div>
                {% endif %}
            </div>
            <h1 style="font-size: 1.5rem; margin: 0;">{{ contact.profil.prenom }} {{ contact.profil.nom }}</h1>
        </div>

        {# zone messages (vide pour l'instant) #}
        <div class="messages-container" style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; min-height: 200px;">
            <div class="alert alert-info">Chargement des messages...</div>
        </div>

        {# zone formulaire (zone de saisie à venir) #}
        <div class="chat-input-area" style="background: white; padding: 1rem; border-top: 1px solid var(--gray-200); position: sticky; bottom: 0;">
            <p class="muted" style="text-align: center; font-size: 0.9rem;">
                (Zone de saisie à venir)
            </p>
        </div>
    </div>
{% endblock %}
