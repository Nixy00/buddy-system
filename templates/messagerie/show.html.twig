{% extends 'base.html.twig' %}

{% block title %}Discussion avec {{ contact.profil.prenom }} - Buddy System{% endblock %}

{% block main %}
    <div class="container" style="padding-top: 2rem; max-width: 800px;">

        {% set isArchived = false %}
        {% for u in conversation.archivePar %}
            {% if u == app.user %}
                {% set isArchived = true %}
            {% endif %}
        {% endfor %}

        {# en-tête #}
        <div class="chat-header" style="display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--gray-200);">
            <a href="{{ path('app_messagerie') }}" class="btn btn--ghost" style="padding: 0.5rem;">&larr; Retour</a>

            <div class="avatar" style="width: 40px; height: 40px;">
                {% if contact.profil.avatar %}
                    <img src="{{ path('app_profil_avatar', {id: contact.profil.id}) }}" alt="{{ contact.profil.prenom }}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
                {% else %}
                    <div style="width: 100%; height: 100%; background: var(--gray-200); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; color: var(--gray-600);">
                        {{ contact.profil.prenom|first }}{{ contact.profil.nom|first }}
                    </div>
                {% endif %}
            </div>
            <h1 style="font-size: 1.5rem; margin: 0;">{{ contact.profil.prenom }} {{ contact.profil.nom }}</h1>
        </div>

        <div id="messages-container" class="messages-container" style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; height: 60vh; overflow-y: auto; padding-right: 10px;">
            {% set lastDate = null %}

            {% for message in conversation.messages %}
                {% set currentDate = message.dateEnvoi|date('Y-m-d') %}

                {% if lastDate != currentDate %}
                    <div class="date-divider" style="text-align: center; margin: 1rem 0; opacity: 0.6;">
                        <span style="background: var(--gray-200); padding: 4px 12px; border-radius: 12px; font-size: 0.8rem; font-weight: 500; color: var(--gray-700);">
                            {{ message.dateEnvoi|buddysmartdate }}
                        </span>
                    </div>
                    {% set lastDate = currentDate %}
                {% endif %}

                {% include 'messagerie/_message.html.twig' with {'message': message, 'isArchived': isArchived} %}

            {% else %}
                <div id="empty-message" style="text-align: center; color: var(--gray-500); padding: 2rem;">
                    <p>C'est le début de votre conversation avec {{ contact.profil.prenom }}.<br>Dites bonjour ! 👋</p>
                </div>
            {% endfor %}
        </div>

        {# zone formulaire #}
        <div class="chat-input-area" style="background: white; padding: 1rem; border-top: 1px solid var(--gray-200); position: sticky; bottom: 0;">

            {% if isArchived %}
                <div style="text-align: center; color: var(--gray-500); padding: 0.5rem;">
                    <p style="margin-bottom: 10px; font-size: 0.9rem;">
                        <i class="fas fa-lock"></i> Cette conversation est archivée (lecture seule).
                    </p>
                    <a href="{{ path('app_conversation_unarchive', {'id': conversation.id}) }}" class="btn btn--primary-outline btn-sm">
                        <i class="fas fa-box-open"></i> Désarchiver pour répondre
                    </a>
                </div>
            {% else %}
                {{ form_start(form, {'attr': {'id': 'chat-form', 'data-url': path('app_messagerie_ajax_send', {id: conversation.id})}}) }}
                <div style="display: flex; gap: 10px; align-items: flex-start;">
                    <div style="flex-grow: 1;">
                        {{ form_widget(form.contenu) }}
                        <div style="color: red; font-size: 0.85rem; margin-top: 5px;">
                            {{ form_errors(form.contenu) }}
                        </div>
                    </div>
                    <button type="submit" class="btn btn--primary" style="height: 100%; padding: 0.8rem 1.5rem; border-radius: 8px;">
                        <i class="fas fa-paper-plane"></i> Envoyer
                    </button>
                </div>
                {{ form_end(form) }}
            {% endif %}

        </div>
    </div>

    {# inclusion du fichier JS externe #}
    <script src="{{ asset('js/messagerie.js') }}" defer></script>
{% endblock %}
